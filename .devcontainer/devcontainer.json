// For format details, see https://aka.ms/devcontainer.json.
{
	"name": "upwins-hsi-preprocessing",
	"build": {
		"context": "..",
		"dockerfile": "Dockerfile"
	},

	// Features to add to the dev container. More info: https://containers.dev/features.
	//"features": {},

	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [],

	// Runs after the workspace is mounted, so the editable install points at the
	// live source tree rather than a build-time copy. Makes `upwins_hsi` and
	// `hsiViewer` importable.
	"postCreateCommand": "python -m pip install --no-cache-dir -e .",

	// Configure tool-specific properties.
	"customizations": {
		"vscode": {
		  "extensions": ["ms-toolsai.jupyter", "ms-python.python"]
		}
	  },

	// No "runArgs": ["--gpus", "all"] on purpose, and do not add it back. The
	// companion upwins-veg-classifier keeps it because it trains a TensorFlow
	// CNN and wants the GPU; this repo runs no TensorFlow and no CUDA code at
	// all, so requiring an NVIDIA GPU would only lock out clients without one.

	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	"remoteUser": "root",

	// Mounts an external data directory over the repo's data/ so large data can
	// live outside the repo. The host path below is hardcoded: edit it if your
	// data is not at ~/projects/upwins/data, or Docker will silently create an
	// empty directory there and the notebooks will fail with confusing
	// missing-file errors. Nothing ships in the repo -- you supply imagery and
	// calibration under data/. See the Data section of README.md.
	"mounts": ["source=${localEnv:HOME}/projects/upwins/data,target=/workspaces/upwins-hsi-preprocessing/data,type=bind,consistency=cached"]
}
