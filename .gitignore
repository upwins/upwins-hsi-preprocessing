# Data lives outside the repo (bind-mounted over data/ in the devcontainer).
# Nothing under data/ is committed, so this needs no exceptions. Nothing ships in
# the repo -- you supply imagery and calibration under data/. See docs/data.md.
data/

# Notebook / Python cruft
__pycache__/
*.pyc
.ipynb_checkpoints/
.env

# Build metadata from `pip install -e .`
*.egg-info/
build/
dist/

# Local virtual environments -- the devcontainer has its own Python, and a
# Windows-native venv (docs/windows_native_setup.md) lives here in the repo.
.venv/
venv/
